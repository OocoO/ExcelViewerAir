<?xml version="1.0" encoding="utf-8"?>
<!-- 离线还原：优先使用本机 NuGet 全局缓存目录（版本化文件夹布局，可作为本地源），
     避免因无法访问 nuget.org 导致 restore 失败。 -->
<configuration>
  <packageSources>
    <clear />
    <add key="local-cache" value="C:\Users\18223\.nuget\packages" />
    <add key="offline-vs" value="C:\Program Files (x86)\Microsoft SDKs\NuGetPackages" />
  </packageSources>
</configuration>
