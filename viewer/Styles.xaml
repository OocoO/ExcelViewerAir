<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- 界面配色：整体浅灰，弱化边框，突出表格内容 -->
    <SolidColorBrush x:Key="ChromeBrush" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="ChromeBorderBrush" Color="#FFD8D8D8" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF2E6CC4" />
    <SolidColorBrush x:Key="MutedBrush" Color="#FF767676" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#FF9A9A9A" />
    <!-- 预览条的可拖动分隔线：平时浅灰，鼠标划过变蓝，提示"这里能拖" -->
    <SolidColorBrush x:Key="SplitterBrush" Color="#FFD6D6D6" />

    <sys:Double x:Key="UiFontSize">12.5</sys:Double>

    <!-- 顶部菜单：像截图那样紧凑 -->
    <Style x:Key="TopMenuItem" TargetType="MenuItem">
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="FontSize" Value="{StaticResource UiFontSize}" />
    </Style>

    <Style TargetType="Menu">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="{StaticResource UiFontSize}" />
    </Style>

    <!-- 工具条按钮：扁平、无边框、悬停才出现底色 -->
    <Style x:Key="ToolToggle" TargetType="ToggleButton">
        <Setter Property="FontSize" Value="{StaticResource UiFontSize}" />
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="#FF333333" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFE4E4E4" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFDCE8FA" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FFA9C7EE" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToolButton" TargetType="Button">
        <Setter Property="FontSize" Value="{StaticResource UiFontSize}" />
        <Setter Property="Padding" Value="7,3" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#FF333333" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFE4E4E4" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFD5D5D5" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#FFB0B0B0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 搜索框：FocusVisualStyle 去掉，避免点击时出现虚线框 -->
    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="BorderBrush" Value="#FFC6C6C6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="White" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <!-- 工作表标签 -->
    <Style x:Key="SheetTab" TargetType="ToggleButton">
        <Setter Property="FontSize" Value="{StaticResource UiFontSize}" />
        <Setter Property="Padding" Value="14,4" />
        <Setter Property="Margin" Value="0,0,1,0" />
        <Setter Property="Foreground" Value="#FF444444" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,2">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFEAEAEA" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="White" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 底部内容预览：只读多行，文本可选中复制；长文本靠自动换行 + 纵向滚动完整显示 -->
    <Style x:Key="PreviewBox" TargetType="TextBox">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI, Consolas" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="#FF202020" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style x:Key="StatusText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,14,0" />
    </Style>

    <Style x:Key="StatusStrong" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#FF333333" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,14,0" />
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Margin" Value="3,4" />
        <Setter Property="Background" Value="#FFDDDDDD" />
    </Style>

</ResourceDictionary>
